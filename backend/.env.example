# Runtime identity. The guarded deterministic fixture requires both
# APP_ENV=e2e and E2E_MODE=true; ordinary development and production keep it off.
APP_ENV=development
E2E_MODE=false
E2E_REQUIRE_BYOK_UI=false

# Active AI Provider: gemini or groq
AI_PROVIDER=gemini
# Keep false for public deployments. Set true only when the deployment owner
# intentionally pays for requests without a user-supplied key.
ALLOW_SERVER_AI_KEY_FALLBACK=false

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# For local dev/testing: GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_RETRIES=2
GEMINI_REQUEST_TIMEOUT=60

# Groq settings
GROQ_API_KEY=your-groq-api-key-here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_REASONING_EFFORT=none
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_MAX_RETRIES=2
GROQ_REQUEST_TIMEOUT=30

# Reconnect-driven processing. The web request executes analysis inline; there is no background worker.
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_MAX_ATTEMPTS=3
PENDING_ITEM_RETENTION_HOURS=168
UPLOAD_DIR=./uploads
# PostgreSQL is required by the asyncpg database layer.
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace_listing_assistant"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="images"
# Optional when running outside Google Cloud. Store the Firebase service-account JSON as a secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated browser origins. Wildcards are rejected because CORS credentials are enabled.
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# Optional: create Notion rows after listing generation.
NOTION_CREATE_ENTRIES=false
# Allow development builds to temporarily disable Notion per request. Keep false in shared/production environments.
NOTION_ALLOW_CLIENT_OVERRIDE=false
NOTION_SYNC_LEASE_SECONDS=300
NOTION_API_KEY=secret_your_notion_internal_connection_token
# Prefer NOTION_DATA_SOURCE_ID for current Notion API versions.
NOTION_DATA_SOURCE_ID=your-marketplace-listings-data-source-id
# Fallback for older Notion database parent API.
NOTION_DATABASE_ID=your-marketplace-listings-database-id
NOTION_API_VERSION=2026-03-11
