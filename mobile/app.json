{
  "expo": {
    "name": "ListFlick",
    "slug": "marketplace-listing-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "listingassistant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.listingassistant.app",
      "googleServicesFile": "./config/GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos and videos of items to generate marketplace listings.",
        "NSPhotoLibraryUsageDescription": "Select photos and videos of items to generate marketplace listings."
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.listingassistant.app",
      "googleServicesFile": "./config/google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/logo-mark-dark.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ListFlick to access your camera to photograph and film items.",
          "microphonePermission": "Allow ListFlick to record sound with item videos. You can record without sound.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ListFlick to access your photos and videos.",
          "microphonePermission": "Allow ListFlick to record sound with item videos. You can record without sound."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ListFlick to save listing photos and videos to your camera roll.",
          "savePhotosPermission": "Allow ListFlick to save listing photos and videos to your camera roll.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_YOUR_REVERSED_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseStaticFix.js",
      "./plugins/withFirebaseSceneInit.js",
      "./plugins/withoutPushEntitlement.js",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
